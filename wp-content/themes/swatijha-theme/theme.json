      "padding": {
        "left": "var(--sj-gutter)",
        "right": "var(--sj-gutter)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "600",
          "lineHeight": "1.2"
        },
        "color": {
