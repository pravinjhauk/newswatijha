  "styles": {
    "color": {
      "background": "var:preset|color|warm-white",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.65"
    },
    "spacing": {
