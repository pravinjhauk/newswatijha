{
  "name": "swatijha-wordpress",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node tooling/build.mjs",
    "dev": "node tooling/playground.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:integration": "node tooling/integration.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "lint": "eslint wp-content/plugins/swatijha-core/editor tooling tests --ignore-pattern \"*.php\"",
    "format:check": "prettier --check wp-content tooling tests",
    "format": "prettier --write wp-content tooling tests",
    "assets:build": "node tooling/images.mjs",
    "package": "node tooling/package.mjs",
    "test:migration": "node --test tests/unit/migration.test.mjs",
    "lint:css": "stylelint \"wp-content/**/editor/*.css\" \"wp-content/themes/**/assets/css/components.css\"",
    "test:performance": "node tooling/performance.mjs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@wordpress/env": "10.37.0",
    "@wordpress/scripts": "36.0.0",
    "@wp-playground/cli": "3.1.0",
    "autoprefixer": "10.6.1",
    "cssnano": "9.1.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "lighthouse": "12.8.2",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "38.0.0",
    "chrome-launcher": "1.2.1"
  }
}
